#!/usr/bin/env bash
# Refuse to push commits whose messages or added lines contain private terms.
set -euo pipefail
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$zero" ]] && continue
  if [[ "$remote_sha" == "$zero" ]]; then
    node scripts/check-private-terms.ts --range "$local_sha" --not --remotes || status=1
  else
    node scripts/check-private-terms.ts --range "$remote_sha..$local_sha" || status=1
  fi
done
exit "$status"
