{
  "name": "@seank/pi-telegram-owner",
  "version": "0.1.0",
  "description": "Standalone Telegram owner transport, canonical archive and explicit optional integrations",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/seank-com/pi-telegram-owner.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./markdown-projector": {
      "types": "./dist/markdown-projector.d.ts",
      "import": "./dist/markdown-projector.js"
    },
    "./importer": {
      "types": "./dist/importer.d.ts",
      "import": "./dist/importer.js"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "import": "./dist/format.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/test.ts",
    "build": "tsc -p tsconfig.json",
    "test:package": "npm run build && node --test tests/package.test.ts",
    "test:integration": "npm run build && node --test tests/integration.test.ts",
    "check:private": "node scripts/check-private-terms.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "dependencies": {
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "parse5": "8.0.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@types/mdast": "4.0.4",
    "@types/node": "24.3.1",
    "typebox": "1.3.27",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "bin": {
    "pi-telegram-register-menu": "./dist/cli/register-telegram-owner-menu.js",
    "pi-telegram-archive-import": "./dist/cli/telegram-archive-import.js"
  }
}
